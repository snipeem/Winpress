<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 10 LTS — longest support window, ships with latest C# and runtime perf -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Winpress</RootNamespace>
    <AssemblyName>Winpress</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Winpress</Product>
    <Company>Winpress</Company>
    <Description>The archive manager Windows should have shipped with. Browse, preview and extract 40+ formats.</Description>
    <Copyright>GPL-3.0</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <!-- ── Publish settings (used by GitHub Actions release workflow) ──────── -->
    <!-- Single self-contained .exe with no runtime dependency on the user's PC -->
    <PublishSingleFile Condition="'$(Configuration)' == 'Release'">true</PublishSingleFile>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Trim unused code to reduce binary size (safe for WPF in .NET 10) -->
    <PublishTrimmed Condition="'$(PublishSingleFile)' == 'true'">false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- Archive reading/writing — 40+ formats, pure managed, no native deps -->
    <!-- Latest stable: 0.42.1 (Dec 2025) -->
    <PackageReference Include="SharpCompress" Version="0.42.1" />

    <!-- Source-generator MVVM — zero boilerplate, .NET 10 source-gen optimised -->
    <!-- Latest stable: 8.4.2 (Mar 2026) -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
