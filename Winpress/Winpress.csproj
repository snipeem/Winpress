<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 10 LTS — longest support window, ships with latest C# and runtime perf -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Winpress</RootNamespace>
    <AssemblyName>Winpress</AssemblyName>
    <Version>1.2.1</Version>
    <AssemblyVersion>1.2.1.0</AssemblyVersion>
    <FileVersion>1.2.1.0</FileVersion>
    <Product>Winpress</Product>
    <Company>snipeem</Company>
    <Description>The archive manager Windows should have shipped with. Browse, preview, extract and compress 40+ formats with AES-256 encryption.</Description>
    <Copyright>Copyright © snipeem</Copyright>
    <InformationalVersion>1.2.1</InformationalVersion>
    <!-- Code signing: Set to your certificate thumbprint or leave empty for unsigned builds -->
    <SignManifests>false</SignManifests>
    <ManifestCertificateThumbprint Condition="'$(CertificateThumbprint)' != ''">$(CertificateThumbprint)</ManifestCertificateThumbprint>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <!-- ── Publish settings (used by GitHub Actions release workflow) ──────── -->
    <!-- Single self-contained .exe with no runtime dependency on the user's PC -->
    <PublishSingleFile Condition="'$(Configuration)' == 'Release'">true</PublishSingleFile>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- R2R: pre-JIT native code baked in → ~40% faster cold launch on first run -->
    <PublishReadyToRun Condition="'$(PublishSingleFile)' == 'true'">true</PublishReadyToRun>

    <!-- Trim unused code to reduce binary size (safe for WPF in .NET 10) -->
    <PublishTrimmed Condition="'$(PublishSingleFile)' == 'true'">false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- Archive reading/writing — 40+ formats, pure managed, no native deps -->
    <!-- Latest stable: 0.50.5 (Oct 2026) -->
    <PackageReference Include="SharpCompress" Version="0.50.5" />

    <!-- Source-generator MVVM — zero boilerplate, .NET 10 source-gen optimised -->
    <!-- Latest stable: 8.4.2 (Mar 2026) -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
