<Window x:Class="Winpress.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Winpress.ViewModels"
        xmlns:converters="clr-namespace:Winpress.Converters"
        Title="Extracting…"
        Width="440" Height="200"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF252525"
        Foreground="White"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="True">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis"/>
        <converters:ProgressPercentConverter  x:Key="ProgressPct"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Archive name -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEC50;" FontSize="18"
                       Foreground="#2B7FD4" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <StackPanel>
                <TextBlock Text="Extracting" FontSize="12" Foreground="#9A9A9A"/>
                <TextBlock Text="{Binding ArchiveName}" FontWeight="SemiBold" FontSize="14"/>
            </StackPanel>
        </StackPanel>

        <!-- Current file -->
        <TextBlock Grid.Row="2"
                   Text="{Binding CurrentFile}"
                   Foreground="#9A9A9A" FontSize="11"
                   TextTrimming="CharacterEllipsis"/>

        <!-- Progress bar -->
        <ProgressBar Grid.Row="4"
                     Value="{Binding Fraction}"
                     Maximum="1" Height="5"/>

        <!-- Count + percent -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Foreground="#9A9A9A" FontSize="11">
                <Run Text="{Binding FilesCompleted, Mode=OneWay}"/>
                <Run Text=" / "/>
                <Run Text="{Binding TotalFiles, Mode=OneWay}"/>
                <Run Text=" files"/>
            </TextBlock>
            <TextBlock Grid.Column="1" Foreground="#9A9A9A" FontSize="11"
                       Text="{Binding Fraction, Converter={StaticResource ProgressPct}}"/>
        </Grid>

        <!-- Done / cancelled / error messages -->
        <TextBlock Grid.Row="7" Foreground="#4CAF50" FontWeight="SemiBold"
                   Text="Extraction complete!"
                   Visibility="{Binding IsComplete, Converter={StaticResource BoolVis}}"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Row="7" Foreground="#9A9A9A"
                   Text="Extraction was cancelled."
                   Visibility="{Binding IsCancelled, Converter={StaticResource BoolVis}}"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Row="7" Foreground="#E53935"
                   Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource BoolVis}}"
                   VerticalAlignment="Center"/>

        <!-- Cancel / Close button -->
        <StackPanel Grid.Row="8" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button Content="Cancel" Width="80" Height="30"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Background="#FF3A3A3A"
                    Visibility="{Binding IsComplete, Converter={StaticResource BoolVis},
                                 ConverterParameter=inverse}"/>
            <Button Content="Close" Width="80" Height="30"
                    Click="Close_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{Binding IsComplete, Converter={StaticResource BoolVis}}"/>
        </StackPanel>
    </Grid>
</Window>
