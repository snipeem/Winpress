<Window x:Class="Winpress.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Winpress.Converters"
        Title="Update Available"
        Width="500" Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF1C1C1C"
        Foreground="White"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False">

    <Window.Resources>
        <converters:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <converters:ProgressPercentConverter         x:Key="PctConv"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header              -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- version badges      -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>     <!-- changelog           -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- progress bar        -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>  <!-- status text         -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- buttons             -->
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE777;"
                       FontSize="28" Foreground="#2B7FD4"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="A new version of Winpress is available"
                           FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="Winpress updates itself — no installer needed."
                           Foreground="#9A9A9A" FontSize="11"/>
            </StackPanel>
        </StackPanel>

        <!-- ── Version badges ─────────────────────────────────────────────── -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Current -->
            <Border Background="#FF2D2D2D" CornerRadius="4" Padding="10,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Current" Foreground="#9A9A9A" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentVersion}" FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- Arrow -->
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE76C;"
                       FontSize="16" Foreground="#2B7FD4"
                       VerticalAlignment="Center" Margin="10,0"/>

            <!-- New -->
            <Border Background="#1A2B7FD4" BorderBrush="#2B7FD4" BorderThickness="1"
                    CornerRadius="4" Padding="10,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="New" Foreground="#2B7FD4" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding NewVersion}" FontWeight="SemiBold" FontSize="13"
                               Foreground="#2B7FD4"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ── Changelog ──────────────────────────────────────────────────── -->
        <Border Grid.Row="4" Background="#FF252525" CornerRadius="4"
                BorderBrush="#FF3C3C3C" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                <TextBox Text="{Binding Changelog, Mode=OneWay}"
                         Background="Transparent" Foreground="#CCCCCC"
                         BorderThickness="0" IsReadOnly="True"
                         TextWrapping="Wrap" FontSize="12"
                         FontFamily="Consolas"
                         VerticalAlignment="Top"/>
            </ScrollViewer>
        </Border>

        <!-- ── Download progress bar ──────────────────────────────────────── -->
        <ProgressBar Grid.Row="6"
                     Value="{Binding DownloadFraction}" Maximum="1"
                     Height="5"
                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}}"/>

        <!-- ── Status text ────────────────────────────────────────────────── -->
        <TextBlock Grid.Row="8"
                   Text="{Binding StatusText}"
                   Foreground="#9A9A9A" FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   Visibility="{Binding StatusText, Converter={StaticResource BoolVis}}"/>

        <!-- ── Buttons ────────────────────────────────────────────────────── -->
        <Grid Grid.Row="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Winpress will restart to apply the update."
                       Foreground="#555" FontSize="11" VerticalAlignment="Center"
                       Visibility="{Binding IsReadyToApply, Converter={StaticResource BoolVis}}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <!-- Later (always available) -->
                <Button Content="Remind me later" Width="120" Height="32"
                        Command="{Binding DismissCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Background="#FF2D2D2D"/>

                <!-- Download button — shown while idle -->
                <Button Content="Download Update" Width="140" Height="32"
                        Command="{Binding UpdateNowCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{Binding IsReadyToApply, Converter={StaticResource InvBoolVis}}"/>

                <!-- Apply button — shown after download completes -->
                <Button Content="✓  Apply &amp; Restart" Width="140" Height="32"
                        Command="{Binding ApplyUpdateCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{Binding IsReadyToApply, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
