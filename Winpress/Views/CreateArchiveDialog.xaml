<Window x:Class="Winpress.Views.CreateArchiveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Archive"
        Width="520" MinHeight="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF252525" Foreground="White"
        FontFamily="Segoe UI" FontSize="13"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- title          -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- source files   -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- output path    -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- format         -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- level          -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- password       -->
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>  <!-- strength bar   -->
            <RowDefinition Height="4"/>
            <RowDefinition Height="Auto"/>  <!-- AES badge      -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>  <!-- confirm pw     -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>  <!-- error          -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- buttons        -->
        </Grid.RowDefinitions>

        <!-- ── Title ─────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7B8;" FontSize="20"
                       Foreground="#2B7FD4" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <StackPanel>
                <TextBlock Text="Create Archive" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock x:Name="SourceLabel" Foreground="#9A9A9A" FontSize="11"
                           Text="Select files or folders to compress"/>
            </StackPanel>
        </StackPanel>

        <!-- ── Source files ──────────────────────────────────────────────── -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Source files" Foreground="#9A9A9A" FontSize="11" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SourcePathBox" Grid.Column="0"
                         Background="#FF3A3A3A" Foreground="White" CaretBrush="White"
                         BorderBrush="#FF555555" BorderThickness="1" Padding="8,6"
                         IsReadOnly="True" VerticalContentAlignment="Center"/>
                <Button Grid.Column="2" Content="Add items…" Width="84" Height="32"
                        Click="AddItems_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Background="#FF3A3A3A"/>
            </Grid>
        </StackPanel>

        <!-- ── Output path ───────────────────────────────────────────────── -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="Output file" Foreground="#9A9A9A" FontSize="11" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="OutputPathBox" Grid.Column="0"
                         Background="#FF3A3A3A" Foreground="White" CaretBrush="White"
                         BorderBrush="#FF555555" BorderThickness="1" Padding="8,6"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="2" Content="Browse…" Width="72" Height="32"
                        Click="Browse_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Background="#FF3A3A3A"/>
            </Grid>
        </StackPanel>

        <!-- ── Format ────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="6">
            <TextBlock Text="Format" Foreground="#9A9A9A" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="FormatCombo"
                      Background="#FF3A3A3A" Foreground="White"
                      BorderBrush="#FF555555" BorderThickness="1" Padding="8,6"
                      SelectionChanged="FormatCombo_SelectionChanged">
                <ComboBoxItem Tag="Zip"       IsSelected="True">ZIP (.zip)  — universal, optional AES-256</ComboBoxItem>
                <ComboBoxItem Tag="SevenZip"              >7-Zip (.7z)  — best ratio, AES-256</ComboBoxItem>
                <ComboBoxItem Tag="TarGz"                 >TAR + GZip (.tar.gz)  — Linux standard</ComboBoxItem>
                <ComboBoxItem Tag="TarBz2"                >TAR + BZip2 (.tar.bz2)  — compact</ComboBoxItem>
                <ComboBoxItem Tag="TarXz"                 >TAR + XZ (.tar.xz)  — best TAR ratio</ComboBoxItem>
                <ComboBoxItem Tag="TarZst"                >TAR + Zstandard (.tar.zst)  — fast + small</ComboBoxItem>
                <ComboBoxItem Tag="Tar"                   >TAR (.tar)  — uncompressed</ComboBoxItem>
                <ComboBoxItem Tag="GZip"                  >GZip (.gz)  — single file</ComboBoxItem>
                <ComboBoxItem Tag="BZip2"                 >BZip2 (.bz2)  — single file</ComboBoxItem>
                <ComboBoxItem Tag="ZStandard"             >Zstandard (.zst)  — single file</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <!-- ── Compression level ─────────────────────────────────────────── -->
        <StackPanel Grid.Row="8" x:Name="LevelPanel">
            <TextBlock Text="Compression level" Foreground="#9A9A9A" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="LevelCombo"
                      Background="#FF3A3A3A" Foreground="White"
                      BorderBrush="#FF555555" BorderThickness="1" Padding="8,6">
                <ComboBoxItem Tag="Fast"   >Fast — smaller time cost, slightly larger file</ComboBoxItem>
                <ComboBoxItem Tag="Default" IsSelected="True">Default — balanced speed and size</ComboBoxItem>
                <ComboBoxItem Tag="Best"   >Best — maximum compression, slowest</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <!-- ── Password ──────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="10" x:Name="PasswordPanel">
            <TextBlock Text="Password  (leave blank for no encryption)"
                       Foreground="#9A9A9A" FontSize="11" Margin="0,0,0,4"/>
            <Grid>
                <PasswordBox x:Name="PasswordBox"
                             Background="#FF3A3A3A" Foreground="White" CaretBrush="White"
                             BorderBrush="#FF555555" BorderThickness="1" Padding="8,6,36,6"
                             PasswordChanged="Password_Changed"
                             VerticalContentAlignment="Center"/>
                <Button x:Name="ShowPwdButton"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="28" Height="24" Margin="0,0,4,0"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="TogglePasswordVisibility_Click"
                        ToolTip="Show password">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7B3;"
                               FontSize="13" Foreground="#9A9A9A"/>
                </Button>
                <!-- Hidden TextBox mirror — swapped in when user clicks Show -->
                <TextBox x:Name="PasswordTextBox"
                         Background="#FF3A3A3A" Foreground="White" CaretBrush="White"
                         BorderBrush="#FF555555" BorderThickness="1" Padding="8,6,36,6"
                         Visibility="Collapsed"
                         VerticalContentAlignment="Center"
                         TextChanged="PasswordTextBox_TextChanged"/>
            </Grid>
        </StackPanel>

        <!-- ── Password strength bar ─────────────────────────────────────── -->
        <Border x:Name="StrengthBar" Grid.Row="12" Height="3" CornerRadius="1.5"
                Background="#FF3A3A3A" Margin="0,0,0,0"
                Visibility="Collapsed"/>

        <!-- ── AES-256 badge ─────────────────────────────────────────────── -->
        <StackPanel Grid.Row="14" x:Name="AesBadgePanel"
                    Orientation="Horizontal" Visibility="Collapsed">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;"
                       FontSize="12" Foreground="#2B7FD4"
                       VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="AES-256 encryption enabled"
                       Foreground="#2B7FD4" FontSize="11" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ── Confirm password ───────────────────────────────────────────── -->
        <StackPanel Grid.Row="16" x:Name="ConfirmPanel" Visibility="Collapsed">
            <TextBlock Text="Confirm password" Foreground="#9A9A9A" FontSize="11" Margin="0,0,0,4"/>
            <Grid>
                <PasswordBox x:Name="ConfirmBox"
                             Background="#FF3A3A3A" Foreground="White" CaretBrush="White"
                             BorderBrush="#FF555555" BorderThickness="1" Padding="8,6,36,6"
                             VerticalContentAlignment="Center"/>
                <Button x:Name="ShowConfirmButton"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="28" Height="24" Margin="0,0,4,0"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="ToggleConfirmVisibility_Click"
                        ToolTip="Show password">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7B3;"
                               FontSize="13" Foreground="#9A9A9A"/>
                </Button>
                <TextBox x:Name="ConfirmTextBox"
                         Background="#FF3A3A3A" Foreground="White" CaretBrush="White"
                         BorderBrush="#FF555555" BorderThickness="1" Padding="8,6,36,6"
                         Visibility="Collapsed"
                         VerticalContentAlignment="Center"/>
            </Grid>
        </StackPanel>

        <!-- ── Error ─────────────────────────────────────────────────────── -->
        <TextBlock Grid.Row="18" x:Name="ErrorLabel"
                   Foreground="#FFE53935" FontSize="11" Visibility="Collapsed"/>

        <!-- ── Buttons ───────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="20" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="88" Height="40" Click="Cancel_Click"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Background="#FF3A3A3A" Margin="0,0,8,0"/>
            <Button Content="Create" Width="88" Height="40" Click="Create_Click"
                    Style="{StaticResource AccentButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
