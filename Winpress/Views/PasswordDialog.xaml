<Window x:Class="Winpress.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password Required"
        Width="360" Height="190"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF252525"
        Foreground="White"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Icon + title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;" FontSize="20"
                       Foreground="#2B7FD4" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <StackPanel>
                <TextBlock Text="Password Required" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="This archive is encrypted." Foreground="#9A9A9A" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <!-- Password field -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Password" Foreground="#9A9A9A" FontSize="11" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox"
                         Background="#FF3A3A3A"
                         Foreground="White"
                         CaretBrush="White"
                         BorderBrush="#FF555555"
                         BorderThickness="1"
                         Padding="8,6"
                         FontSize="13"
                         KeyDown="PasswordBox_KeyDown"/>
        </StackPanel>

        <!-- Error message -->
        <TextBlock Grid.Row="4" x:Name="ErrorLabel"
                   Foreground="#FFE53935" FontSize="11"
                   Visibility="Collapsed"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Width="80" Height="30"
                    Click="Cancel_Click"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Background="#FF3A3A3A"/>
            <Button Content="Unlock" Width="80" Height="30"
                    Click="OK_Click"
                    Style="{StaticResource AccentButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
