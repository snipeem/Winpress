<Window x:Class="Winpress.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Winpress.ViewModels"
        xmlns:converters="clr-namespace:Winpress.Converters"
        mc:Ignorable="d"
        Title="Winpress"
        Width="900" Height="580"
        MinWidth="640" MinHeight="380"
        Style="{StaticResource MainWindowStyle}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <converters:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <converters:EmptyCollectionToVisibilityConverter x:Key="EmptyVis"/>
        <converters:NullToVisibilityConverter        x:Key="NullVis"/>

        <!-- Icon cell template — Segoe MDL2 glyph + file name -->
        <DataTemplate x:Key="NameCellTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           Text="{Binding IconGlyph}"
                           FontSize="14"
                           Foreground="#2B7FD4"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Width="16" TextAlignment="Center"/>
                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <!-- Lock icon for encrypted entries -->
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;"
                           FontSize="10" Foreground="#9A9A9A"
                           VerticalAlignment="Center" Margin="6,0,0,0"
                           Visibility="{Binding IsEncrypted, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Menu bar        -->
            <RowDefinition Height="Auto"/>  <!-- Toolbar         -->
            <RowDefinition Height="Auto"/>  <!-- Separator       -->
            <RowDefinition Height="Auto"/>  <!-- Breadcrumb      -->
            <RowDefinition Height="Auto"/>  <!-- Separator       -->
            <RowDefinition Height="*"/>     <!-- File list       -->
            <RowDefinition Height="Auto"/>  <!-- Status bar      -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════
             MENU BAR
             ═══════════════════════════════════════════════════ -->
        <Menu Grid.Row="0" Background="#FF1F1F1F" Foreground="White" Padding="4,2">
            <MenuItem Header="_File" Foreground="White">
                <MenuItem Header="Open Archive…"    Click="MenuOpen_Click"
                          InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="Extract All…"
                          Command="{Binding ExtractAllCommand}"
                          InputGestureText="Ctrl+E"/>
                <MenuItem Header="Extract Selected…"
                          Command="{Binding ExtractSelectedCommand}"
                          InputGestureText="Ctrl+Shift+E"/>
                <Separator/>
                <MenuItem Header="_Exit"            Click="MenuExit_Click"
                          InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_View" Foreground="White">
                <MenuItem Header="Navigate Back"
                          Command="{Binding NavigateBackCommand}"
                          InputGestureText="Alt+←"/>
                <Separator/>
                <MenuItem Header="Sort by _Name"     Command="{Binding SortByCommand}" CommandParameter="Name"/>
                <MenuItem Header="Sort by _Size"     Command="{Binding SortByCommand}" CommandParameter="Size"/>
                <MenuItem Header="Sort by _Modified" Command="{Binding SortByCommand}" CommandParameter="Modified"/>
                <MenuItem Header="Sort by _Type"     Command="{Binding SortByCommand}" CommandParameter="Type"/>
            </MenuItem>
            <MenuItem Header="_Tools" Foreground="White">
                <MenuItem Header="Register Explorer Context Menus"
                          Command="{Binding ToggleShellIntegrationCommand}"
                          IsCheckable="True"
                          IsChecked="{Binding ShellIntegrationEnabled, Mode=OneWay}"/>
            </MenuItem>
            <MenuItem Header="_Help" Foreground="White">
                <MenuItem Header="About Winpress" Click="MenuAbout_Click"/>
                <MenuItem Header="View on GitHub"  Click="MenuGitHub_Click"/>
            </MenuItem>
        </Menu>

        <!-- ═══════════════════════════════════════════════════
             TOOLBAR
             ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#FF1F1F1F" Padding="6,5">
            <DockPanel>
                <!-- Left actions -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4">
                    <!-- Open -->
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Click="MenuOpen_Click" ToolTip="Open Archive (Ctrl+O)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Open" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                               Background="#FF3C3C3C" Width="1" Margin="2,4"/>

                    <!-- Back -->
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding NavigateBackCommand}"
                            ToolTip="Navigate Back (Alt+←)">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE76B;" FontSize="14"/>
                    </Button>

                    <Separator Background="#FF3C3C3C" Width="1" Margin="2,4"/>

                    <!-- Extract All -->
                    <Button Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding ExtractAllCommand}"
                            ToolTip="Extract All Files (Ctrl+E)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Extract All" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Extract Selected -->
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding ExtractSelectedCommand}"
                            ToolTip="Extract Selected Files (Ctrl+Shift+E)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA52;"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Extract Selected" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: search box -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" Spacing="6">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;"
                               FontSize="13" Foreground="#9A9A9A" VerticalAlignment="Center"/>
                    <TextBox Style="{StaticResource SearchBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Width="180" Height="28"
                             ToolTip="Search files in archive"/>
                </StackPanel>

                <FrameworkElement/>
            </DockPanel>
        </Border>

        <Separator Grid.Row="2" Background="#FF3C3C3C"/>

        <!-- ═══════════════════════════════════════════════════
             BREADCRUMB BAR
             ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="#FF2D2D2D" Padding="10,5"
                Visibility="{Binding HasArchive, Converter={StaticResource BoolVis}}">
            <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding Name}"
                                    Style="{StaticResource BreadcrumbButtonStyle}"
                                    Command="{Binding DataContext.NavigateToBreadcrumbCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                            <TextBlock Text=" ›" Foreground="#555"
                                       VerticalAlignment="Center" FontSize="14"
                                       Margin="0,0,4,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Separator Grid.Row="4" Background="#FF3C3C3C"/>

        <!-- ═══════════════════════════════════════════════════
             FILE LIST
             ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="5">
            <!-- Empty / home state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasArchive, Converter={StaticResource InvBoolVis}}">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEC50;"
                           FontSize="64" Foreground="#FF3C3C3C"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Open or drop an archive here"
                           Foreground="#FF555555" FontSize="16"
                           HorizontalAlignment="Center" Margin="0,12,0,6"/>
                <TextBlock Text="ZIP · 7z · RAR · TAR · GZ · BZ2 · XZ · ISO · WIM · CAB · DEB · and more"
                           Foreground="#FF444444" FontSize="12"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Loading spinner -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;"
                           FontSize="32" Foreground="#2B7FD4"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Opening archive…" Foreground="#9A9A9A"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Archive list view -->
            <ListView x:Name="ArchiveListView"
                      ItemsSource="{Binding DisplayEntries}"
                      Visibility="{Binding HasArchive, Converter={StaticResource BoolVis}}"
                      SelectionChanged="ArchiveListView_SelectionChanged"
                      MouseDoubleClick="ArchiveListView_DoubleClick"
                      KeyDown="ArchiveListView_KeyDown"
                      GridViewColumnHeader.Click="ColumnHeader_Click"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name"     Width="300"
                                        CellTemplate="{StaticResource NameCellTemplate}"/>
                        <GridViewColumn Header="Type"     Width="110"
                                        DisplayMemberBinding="{Binding TypeDisplay}"/>
                        <GridViewColumn Header="Size"     Width="85"
                                        DisplayMemberBinding="{Binding SizeDisplay}"/>
                        <GridViewColumn Header="Packed"   Width="85"
                                        DisplayMemberBinding="{Binding CompressedSizeDisplay}"/>
                        <GridViewColumn Header="Ratio"    Width="65"
                                        DisplayMemberBinding="{Binding RatioDisplay}"/>
                        <GridViewColumn Header="Modified" Width="140"
                                        DisplayMemberBinding="{Binding ModifiedDisplay}"/>
                    </GridView>
                </ListView.View>
                <ListView.ContextMenu>
                    <ContextMenu Background="#FF2D2D2D" Foreground="White">
                        <MenuItem Header="Extract Here"
                                  Command="{Binding ExtractSelectedCommand}"
                                  FontFamily="Segoe UI"/>
                        <MenuItem Header="Extract to Folder…"
                                  Command="{Binding ExtractSelectedCommand}"
                                  FontFamily="Segoe UI"/>
                        <Separator Background="#FF3C3C3C"/>
                        <MenuItem Header="Open" Click="ContextOpen_Click"
                                  FontFamily="Segoe UI"/>
                        <Separator Background="#FF3C3C3C"/>
                        <MenuItem Header="Select All" Click="ContextSelectAll_Click"
                                  InputGestureText="Ctrl+A"
                                  FontFamily="Segoe UI"/>
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>
        </Grid>

        <!-- ═══════════════════════════════════════════════════
             STATUS BAR
             ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="6" Background="#FF1A1A1A" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusText}"
                           Foreground="#9A9A9A" FontSize="11"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding ArchiveName}"
                           Foreground="#9A9A9A" FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
